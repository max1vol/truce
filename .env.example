# Team page -> Show my line. Keep the real value in Vercel Environment Variables.
AGENT_STUDIO_VERIFIER_TOKEN=
# Throwaway Solana devnet key only. Generate with npm run wallet.
AGENT_PRIVATE_KEY=
AGENT_PUBLIC_KEY=
# Server-side OpenAI access for authenticated race tasks. Never use NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Authenticated hackathon payments use Solana devnet test tokens only.
PAYMENTS_ENABLED=false
PAYMENT_MAX_USDC=0.05
PAYMENT_TOTAL_CAP_USDC=0.10
# Private Blob journal; initialize once before enabling payments.
BLOB_READ_WRITE_TOKEN=
